# Each key is a web username. For Telegram, use the sender's numeric user ID.
PKA_WEB_USERS='{"1":"replace-me"}'
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Local Qwen GGUF; Compose mounts ./models at /models. CPU by default.
MODEL_PATH=/models/Qwen3-4B-Instruct-2507-Q4_K_M.gguf
MODEL_CONTEXT_SIZE=4096
MODEL_GPU_LAYERS=0
LOG_FORMAT=console

# Optional OpenAI-compatible embeddings endpoint. Leave blank for keyword search only.
EMBEDDINGS_URL=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSIONS=
EMBEDDINGS_API_KEY=

# HTML/XHTML fetching. Values may lower these limits.
PAGE_FETCH_TIMEOUT_SECONDS=30
PAGE_FETCH_MAX_REDIRECTS=5
PAGE_FETCH_MAX_BYTES=5000000
PAGE_FETCH_RETRIES=2
